{
  "name": "dependency-analyzer",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "homepage": "https://github.com/hakanolgun/dependency-analyzer",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli:build": "npm --workspace @hakanolgun/dependency-analyzer run build:binaries",
    "cli:run": "node ./packages/dependency-analyzer/bin/dependency-analyzer.js",
    "cli:test": "cd cli-go && go test ./...",
    "release": "cd packages/dependency-analyzer && npm publish && cd ../.."
  }
}
