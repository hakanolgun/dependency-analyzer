{{define "maintenance_go"}}
      <div class="maintenance-legend-section">
        <div class="legend-container">
          <h3 class="legend-title">Maintenance Status</h3>
          <div class="legend-grid">
            <div class="legend-item">
              <div class="legend-badge badge-yes"><span class="lg-ico">&#10003;</span><span>Yes</span></div>
              <p class="legend-description">The module is active, has recent updates, and is not abandoned.</p>
            </div>
            <div class="legend-item">
              <div class="legend-badge badge-unlikely"><span class="lg-ico">&#9888;</span><span>Unlikely</span></div>
              <p class="legend-description">No updates in the last 3 years. The module might be abandoned.</p>
            </div>
          </div>
        </div>
      </div>
{{end}}
